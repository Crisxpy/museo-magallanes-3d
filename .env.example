# --- Supabase ---
# Se obtienen en supabase.com -> tu proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Service role key: SOLO se usa en el servidor (API routes), nunca en el navegador.
# Se necesita para que el prescrapper pueda escribir/leer sin restricciones de RLS
# cuando el admin está autenticado. Mantener esta clave en secreto.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
